    {
      "name": "recursiveSolution",
      "description": "",
      "approach": "- Use a recursive function to calculate the power of x to the power of n\n - If x is 0 and n is less than or equal to 0, return NaN\n - If x is 0, return 0\n - If n is 1, return x\n - If n is negative, return 1 / x to the power of -n\n - Otherwise, return x to the power of n",
      "timeComplexity": "O(log |n|)",
      "spaceComplexity": "O(log |n|)",
      "code": "<pre><code class=\"language-typescript\"><span class=\"hljs-keyword\">const</span> <span class=\"hljs-title function_\">recursiveSolution</span> = (<span class=\"hljs-params\">x, n</span>) =&gt; {\n  <span class=\"hljs-keyword\">if</span> (x === <span class=\"hljs-number\">0</span> &amp;&amp; n &lt;= <span class=\"hljs-number\">0</span>) {\n    <span class=\"hljs-keyword\">return</span> <span class=\"hljs-title class_\">NaN</span>;\n  }\n  <span class=\"hljs-keyword\">if</span> (x === <span class=\"hljs-number\">0</span>) {\n    <span class=\"hljs-keyword\">return</span> <span class=\"hljs-number\">0</span>;\n  }\n  <span class=\"hljs-keyword\">function</span> <span class=\"hljs-title function_\">times</span>(<span class=\"hljs-params\"><span class=\"hljs-attr\">x</span>: <span class=\"hljs-built_in\">number</span>, <span class=\"hljs-attr\">n</span>: <span class=\"hljs-built_in\">number</span></span>): <span class=\"hljs-built_in\">number</span> {\n    <span class=\"hljs-keyword\">if</span> (n === <span class=\"hljs-number\">0</span>) {\n      <span class=\"hljs-keyword\">return</span> <span class=\"hljs-number\">1</span>;\n    }\n    <span class=\"hljs-keyword\">if</span> (n % <span class=\"hljs-number\">2</span> === <span class=\"hljs-number\">0</span>) {\n      <span class=\"hljs-keyword\">const</span> intermediate = <span class=\"hljs-title function_\">times</span>(x, n / <span class=\"hljs-number\">2</span>);\n      <span class=\"hljs-keyword\">return</span> intermediate * intermediate;\n    }\n    <span class=\"hljs-keyword\">return</span> x * <span class=\"hljs-title function_\">times</span>(x, n - <span class=\"hljs-number\">1</span>);\n  }\n  <span class=\"hljs-keyword\">const</span> initial = n &gt;= <span class=\"hljs-number\">0</span> ? x : <span class=\"hljs-number\">1</span> / x;\n  <span class=\"hljs-keyword\">return</span> <span class=\"hljs-title function_\">times</span>(initial, <span class=\"hljs-title class_\">Math</span>.<span class=\"hljs-title function_\">abs</span>(n));\n};\n</code></pre>",
